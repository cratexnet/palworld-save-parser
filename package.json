{
  "name": "palworld-save-parser",
  "version": "0.1.0",
  "description": "A browser-only Palworld save parser with an iframe message interface.",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cratexnet/palworld-save-parser.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ooz-wasm": {
      "types": "./dist/ooz-wasm-decoder.d.ts",
      "default": "./dist/ooz-wasm-decoder.js"
    },
    "./worker-client": {
      "types": "./dist/save-parser-worker-client.d.ts",
      "default": "./dist/save-parser-worker-client.js"
    }
  },
  "files": [
    "app",
    "dist",
    "scripts",
    "src",
    "tsconfig.json",
    "tsconfig.app.json",
    "tsconfig.build.json",
    "vitest.config.ts",
    "vendor/palworld-ooz",
    "COPYRIGHT",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "node scripts/clean-build-output.mjs && tsc -p tsconfig.build.json && node scripts/fix-dist-imports.mjs",
    "build:app": "vite build app --outDir ../dist-app --emptyOutDir && node scripts/prepare-app-distribution.mjs && node scripts/generate-cratex-build-manifest.mjs",
    "build:release": "pnpm build:app && node scripts/verify-release-build.mjs",
    "format:check": "prettier --check \"src/**/*.ts\" \"app/**/*.{ts,tsx,html}\" \"scripts/**/*.mjs\" \".github/**/*.{yml,yaml}\" \"*.{json,md,yaml}\"",
    "dev:app": "vite app --host 0.0.0.0",
    "prepack": "pnpm build",
    "preview:app": "vite preview app --outDir ../dist-app --host 0.0.0.0",
    "smoke:real-save": "pnpm build && node scripts/smoke-real-save.mjs",
    "test": "vitest run",
    "type-check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.app.json --noEmit"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "prettier": "^3.9.4",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@12.21.0"
}
